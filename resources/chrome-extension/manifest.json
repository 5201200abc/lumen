{
  "manifest_version": 3,
  "name": "Lumen Browser Bridge",
  "version": "0.7.0",
  "minimum_chrome_version": "116",
  "description": "Lets Lumen inspect and test pages in your existing Chrome session.",
  "key": "",
  "permissions": [
    "activeTab",
    "alarms",
    "debugger",
    "storage",
    "tabGroups",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "Lumen Browser Bridge",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    },
    "default_popup": "popup.html"
  }
}
