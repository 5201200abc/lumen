{
  "name": "lumen",
  "productName": "Lumen",
  "version": "0.7.0",
  "description": "Private desktop AI chat and Claude Agent cowork for local models",
  "main": "out/main/index.js",
  "type": "module",
  "author": {
    "name": "5201200abc",
    "email": "5201200abc@gmail.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "verify:runtime": "node scripts/runtime-smoke.mjs",
    "verify:cancel": "node scripts/runtime-cancel.mjs",
    "verify:long-output": "node scripts/runtime-long-output.mjs",
    "verify:interruption": "node scripts/runtime-interruption.mjs",
    "verify:benchmark": "node scripts/runtime-benchmark.mjs",
    "verify:model-router": "node scripts/runtime-model-router.mjs",
    "verify:permissions": "node scripts/runtime-permissions.mjs",
    "verify:checkpoint": "node scripts/runtime-checkpoint.mjs",
    "verify:style": "node scripts/runtime-style.mjs",
    "verify:sources": "node scripts/runtime-sources.mjs",
    "verify:model-sync": "node scripts/runtime-model-sync.mjs",
    "dist": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "dist:mac": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "dist:mac:arm64": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64",
    "dist:mac:x64": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --x64",
    "dist:win": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "dist:win:x64": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --x64",
    "dist:win:arm64": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --arm64",
    "dist:linux": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --linux",
    "dist:linux:x64": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --linux --x64",
    "dist:linux:arm64": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --linux --arm64",
    "dist:all": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder -mwl",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.247",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-store": "^10.1.0",
    "jszip": "^3.10.1",
    "node-pty": "^1.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/sql.js": "^1.4.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^41.10.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "ws": "^8.21.3"
  }
}
